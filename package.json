{
  "name": "frontend_tmp",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "engines": {
    "node": ">=20.19.0 || >=22.12.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "lint": "eslint .",
    "preview": "vite preview",
    "test": "vitest",
    "test:run": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "test:e2e:docker": "docker build -f Dockerfile.e2e -t frontend-e2e . && docker run --rm -e CI=true -v \"$(pwd)/playwright-report:/app/playwright-report\" -v \"$(pwd)/test-results:/app/test-results\" frontend-e2e",
    "test:e2e:docker:build": "docker build -f Dockerfile.e2e -t frontend-e2e .",
    "test:e2e:ui": "playwright test --ui"
  },
  "dependencies": {
    "@lottiefiles/dotlottie-react": "^0.19.1",
    "@tailwindcss/vite": "^4.2.2",
    "@xyflow/react": "^12.11.3",
    "axios": "^1.14.0",
    "chart.js": "^4.5.1",
    "react": "^19.2.4",
    "react-chartjs-2": "^5.3.1",
    "react-dom": "^19.2.4",
    "react-router-dom": "^7.14.0",
    "tailwindcss": "^4.2.2"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.4",
    "@playwright/test": "^1.62.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.3",
    "@types/node": "^26.1.2",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.1",
    "@vitest/coverage-v8": "^4.1.10",
    "eslint": "^9.39.4",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "globals": "^17.4.0",
    "happy-dom": "^20.11.1",
    "typescript": "^5.9.3",
    "vite": "^8.0.1",
    "vite-tsconfig-paths": "^6.1.1",
    "vitest": "^4.1.10"
  },
  "optionalDependencies": {
    "@rolldown/binding-darwin-x64": "^1.0.0-rc.17"
  }
}
